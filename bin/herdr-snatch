#!/usr/bin/env python3
"""Pick text from Herdr pane output to insert, copy, or open."""

import argparse
import concurrent.futures
import json
import os
import re
import shlex
import shutil
import string
import subprocess
import sys
import tempfile
from pathlib import Path
from urllib.parse import urlsplit


SCROLLBACK_LINES = 10_000_000
SCOPES = ("pane", "tab", "workspace")
SOURCES = ("visible", "scrollback")
URL = re.compile(r"(?:https?|ftp|file)://[^\s<>\"']+")
PATH = re.compile(r"(?<![\w:/])(?:~?/|\.{1,2}/)?[\w.+@~-]+(?:/[\w.+@~-]+)+")
HASH = re.compile(r"(?<![0-9a-fA-F])[0-9a-fA-F]{7,40}(?![0-9a-fA-F])")
WORD = re.compile(r"[^\s\[\](){}<>'\"|,;]+")
# A word followed by a number, such as "PR #123" or "task 42". Only kept when an opener matches it.
PREFIXED_NUMBER = re.compile(r"(?<![\w#-])[A-Za-z][\w-]*\s+#?\d+(?!\w)")
TRAILING = ".,;:!?)]}>\"'"
DEFAULT_OPENERS = (
    {"name": "GitHub", "match": r"(?P<owner>[\w.-]+)/(?P<repo>[\w.-]+)#(?P<number>\d+)",
     "url": "https://github.com/{owner}/{repo}/issues/{number}"},
)


def candidates(scrollback, openers=()):
    """Keep the newest occurrence of each candidate first."""
    seen = set()

    def add_line(line, include_whole_line=True):
        if not line:
            return
        for match in PREFIXED_NUMBER.finditer(line):
            value = match.group()
            if value not in seen and matching_openers(value, openers):
                seen.add(value)
                yield value
        for pattern in (URL, PATH, HASH, WORD):
            for match in pattern.finditer(line):
                value = match.group().strip(TRAILING)
                if value and value not in seen:
                    seen.add(value)
                    yield value
        if include_whole_line and line not in seen:
            seen.add(line)
            yield line

    rows = ["".join(char if char.isprintable() else " " for char in raw_line).strip()
            for raw_line in scrollback.splitlines()]
    for index in range(len(rows) - 1, -1, -1):
        yield from add_line(rows[index])
        if index:
            # Visible screen rows omit the wrap boundary; retain candidates
            # formed by joining adjacent rows without adding a space.
            yield from add_line(rows[index - 1] + rows[index], include_whole_line=False)


def choices(herdr, pane_id, tab_id, workspace_id, scope, source):
    pane_ids = [pane_id]
    if scope != "pane":
        panes = json.loads(subprocess.run(
            [herdr, "pane", "list", "--workspace", workspace_id],
            check=True, capture_output=True, text=True,
        ).stdout)["result"]["panes"]
        pane_ids.extend(
            pane["pane_id"] for pane in panes
            if pane["pane_id"] != pane_id and (scope == "workspace" or pane["tab_id"] == tab_id)
        )

    def read(pane):
        command = [herdr, "pane", "read", pane, "--source", "visible" if source == "visible" else "recent-unwrapped"]
        if source == "scrollback":
            command.extend(("--lines", str(SCROLLBACK_LINES)))
        return subprocess.run(command, check=True, capture_output=True, text=True, errors="replace").stdout

    openers = load_openers()
    seen = set()
    with concurrent.futures.ThreadPoolExecutor(max_workers=min(8, len(pane_ids))) as pool:
        for output in pool.map(read, pane_ids):
            for candidate in candidates(output, openers):
                if candidate not in seen:
                    seen.add(candidate)
                    yield candidate


def header(scope, source):
    return f"{scope}/{source} | ^P/^T/^W scope ^V/^R source ^Y copy ^O open"


def load_settings():
    config_dir = os.environ.get("HERDR_PLUGIN_CONFIG_DIR")
    if config_dir:
        config_file = Path(config_dir) / "settings.json"
        if config_file.exists():
            return json.loads(config_file.read_text())
    return {}


def default_search():
    settings = load_settings()
    scope = settings.get("scope", "tab")
    source = settings.get("source", "visible")
    if scope not in SCOPES or source not in SOURCES:
        sys.exit("herdr-snatch: invalid scope or source in settings.json")
    return scope, source


def load_openers():
    """Built-in openers, overridden by name or extended by settings.json "openers"."""
    by_name = {opener["name"]: opener for opener in DEFAULT_OPENERS}
    for opener in load_settings().get("openers", []):
        by_name[opener["name"]] = opener
    openers = []
    for opener in by_name.values():
        if ("url" in opener) == ("command" in opener) or "match" not in opener:
            sys.exit(f"herdr-snatch: opener {opener['name']!r} needs match and exactly one of url or command")
        openers.append({**opener, "pattern": re.compile(opener["match"])})
    return openers


def matching_openers(value, openers):
    """Return (opener, fields) pairs, highest priority first; ties keep config order."""
    matches = []
    for opener in openers:
        match = opener["pattern"].fullmatch(value)
        if match:
            fields = {**opener.get("defaults", {}),
                      **{key: group for key, group in match.groupdict().items() if group is not None}}
            matches.append((opener, fields))
    return sorted(matches, key=lambda pair: -pair[0].get("priority", 0))


def opener_target(opener, fields):
    try:
        if "url" in opener:
            return opener["url"].format(**fields)
        return [part.format(**fields) for part in opener["command"]]
    except KeyError as error:
        sys.exit(f"herdr-snatch: opener {opener['name']!r} has no value for {error}")


def pane_cwd(pane_id=None, herdr="herdr"):
    cwd = os.environ.get("HERDR_ACTIVE_PANE_CWD")
    if not cwd and pane_id:
        pane = json.loads(subprocess.run(
            [herdr, "pane", "get", pane_id], check=True, capture_output=True, text=True,
        ).stdout)["result"]["pane"]
        cwd = pane.get("foreground_cwd") or pane["cwd"]
    return cwd or os.getcwd()


def git_repo_url(cwd, remote=None):
    def git(*args):
        try:
            return subprocess.run(
                ["git", "-C", cwd, *args], check=True, capture_output=True, text=True,
            ).stdout.strip()
        except (OSError, subprocess.CalledProcessError) as error:
            detail = error.stderr.strip() if isinstance(error, subprocess.CalledProcessError) else str(error)
            sys.exit(f"herdr-snatch: cannot resolve Git repository: {detail}")

    if remote is None:
        remotes = git("remote").splitlines()
        remote = next((name for name in ("upstream", "origin") if name in remotes), None)
        if remote is None:
            if len(remotes) != 1:
                sys.exit("herdr-snatch: no unambiguous Git remote; set git_remote on the opener")
            remote = remotes[0]
    url = git("remote", "get-url", remote)
    if "://" not in url:
        match = re.fullmatch(r"(?:[^/@:]+@)?([^/:]+):(.+)", url)
        if not match:
            sys.exit(f"herdr-snatch: Git remote is not a web repository: {url}")
        url = f"ssh://{match[1]}/{match[2]}"
    parsed = urlsplit(url)
    path = parsed.path.rstrip("/").removesuffix(".git")
    if parsed.scheme not in ("http", "https", "ssh", "git") or not parsed.hostname or not path.strip("/"):
        sys.exit(f"herdr-snatch: Git remote is not a web repository: {url}")
    host = parsed.hostname
    if ":" in host:
        host = f"[{host}]"
    if parsed.scheme in ("http", "https") and parsed.port:
        host += f":{parsed.port}"
    scheme = parsed.scheme if parsed.scheme in ("http", "https") else "https"
    return f"{scheme}://{host}{path}"


def choose_opener(value, matches):
    """Open directly when one opener outranks the rest; otherwise ask."""
    if len(matches) == 1 or matches[0][0].get("priority", 0) > matches[1][0].get("priority", 0):
        return matches[0]
    lines = []
    for index, (opener, fields) in enumerate(matches):
        target = opener_target(opener, fields)
        lines.append(f"{index}\t{opener['name']}\t{target if isinstance(target, str) else shlex.join(target)}")
    picker = subprocess.run(
        ["fzf", "--layout=reverse", "--info=hidden", "--no-separator", "--no-scrollbar", "--no-multi",
         "--delimiter=\t", "--with-nth=2..", f"--header=Open {value} as", "--prompt=> "],
        input="\n".join(lines) + "\n", stdout=subprocess.PIPE, text=True,
        env={**os.environ, "FZF_DEFAULT_OPTS": ""},
    )
    if picker.returncode in (1, 130):
        return None
    picker.check_returncode()
    return matches[int(picker.stdout.split("\t", 1)[0])]


def open_selection(value, pane_id, herdr):
    matches = matching_openers(value, load_openers())
    if not matches:
        open_target(value, pane_id, herdr)
        return
    if len(matches) > 1 and matches[0][0].get("priority", 0) > matches[1][0].get("priority", 0):
        matches = matches[:1]
    for opener, fields in matches:
        templates = [opener["url"]] if "url" in opener else opener["command"]
        if "git_repo_url" not in fields and any(
            field == "git_repo_url" for template in templates
            for _, field, _, _ in string.Formatter().parse(template)
        ):
            fields["git_repo_url"] = git_repo_url(pane_cwd(pane_id, herdr), opener.get("git_remote"))
    chosen = choose_opener(value, matches)
    if not chosen:
        return
    target = opener_target(*chosen)
    if isinstance(target, str):
        launch(target)
    else:
        subprocess.Popen(target, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


def copy_to_clipboard(value):
    if os.environ.get("WAYLAND_DISPLAY") and shutil.which("wl-copy"):
        command = ["wl-copy"]
    elif os.environ.get("DISPLAY") and shutil.which("xclip"):
        command = ["xclip", "-selection", "clipboard"]
    elif shutil.which("pbcopy"):
        command = ["pbcopy"]
    else:
        sys.exit("herdr-snatch: install wl-copy, xclip, or pbcopy to copy text")
    subprocess.run(command, input=value, text=True, check=True)


def open_target(value, pane_id=None, herdr="herdr"):
    if URL.fullmatch(value):
        target = value
    else:
        path = Path(value).expanduser()
        if not path.is_absolute():
            path = Path(pane_cwd(pane_id, herdr)) / path
        if not path.exists():
            sys.exit(f"herdr-snatch: file does not exist: {value}")
        target = str(path.resolve())
    launch(target)


def launch(target):
    opener = "open" if sys.platform == "darwin" else "xdg-open"
    if not shutil.which(opener):
        sys.exit(f"herdr-snatch: {opener} is required to open a selection")
    subprocess.Popen([opener, target], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    parser = argparse.ArgumentParser(description=__doc__)
    default_scope, default_source = default_search()
    parser.add_argument("--scope", choices=SCOPES, default=default_scope)
    parser.add_argument("--source", choices=SOURCES, default=default_source)

    if argv[:1] == ["--switch"]:
        if len(argv) != 4:
            parser.error("invalid switch arguments")
        state = Path(argv[1])
        scope, source = state.read_text().split()
        kind, value = argv[2:4]
        if kind == "scope" and value in SCOPES:
            scope = value
        elif kind == "source" and value in SOURCES:
            source = value
        else:
            parser.error("invalid switch mode")
        replacement = state.with_suffix(".new")
        replacement.write_text(f"{scope} {source}")
        replacement.replace(state)
        script = shlex.quote(str(Path(__file__).resolve()))
        print(f"reload({script} --list {shlex.quote(str(state))})")
        return

    args = parser.parse_args(argv) if argv[:1] != ["--list"] else None

    pane_id = os.environ.get("HERDR_ACTIVE_PANE_ID")
    if not pane_id:
        sys.exit("herdr-snatch: no originating pane (HERDR_ACTIVE_PANE_ID)")
    herdr = os.environ.get("HERDR_BIN_PATH", "herdr")
    tab_id = os.environ.get("HERDR_ACTIVE_TAB_ID")
    workspace_id = os.environ.get("HERDR_ACTIVE_WORKSPACE_ID")

    if args is None:
        if len(argv) != 2:
            parser.error("invalid list arguments")
        state = Path(argv[1])
        scope, source = state.read_text().split()
        print(header(scope, source))
        items = list(choices(herdr, pane_id, tab_id, workspace_id, scope, source))
        if items:
            print("\n".join(items))
        return

    if not tab_id or not workspace_id:
        sys.exit("herdr-snatch: missing tab or workspace context")
    if not shutil.which("fzf"):
        print("fzf is required. Install it, then press Enter to close.", flush=True)
        sys.stdin.readline()
        return

    initial = "\n".join(choices(herdr, pane_id, tab_id, workspace_id, args.scope, args.source))
    with tempfile.TemporaryDirectory(prefix="herdr-snatch-") as directory:
        state = Path(directory) / "mode"
        state.write_text(f"{args.scope} {args.source}")
        script = shlex.quote(str(Path(__file__).resolve()))
        state_arg = shlex.quote(str(state))
        bindings = ["tab:accept"]
        for key, kind, value in (("ctrl-p", "scope", "pane"), ("ctrl-t", "scope", "tab"),
                                 ("ctrl-w", "scope", "workspace"), ("ctrl-v", "source", "visible"),
                                 ("ctrl-r", "source", "scrollback")):
            bindings.append(f"{key}:transform({script} --switch {state_arg} {kind} {value})")

        picker = subprocess.run(
            ["fzf", "--layout=reverse", "--info=hidden", "--no-separator", "--no-scrollbar",
             "--no-multi", "--tiebreak=index", "--prompt=> ", "--header-lines=1", "--expect=ctrl-y,ctrl-o",
             *("--bind=" + binding for binding in bindings)],
            input=header(args.scope, args.source) + "\n" + initial + "\n", stdout=subprocess.PIPE, text=True,
            env={**os.environ, "FZF_DEFAULT_OPTS": ""},
        )
    if picker.returncode == 130 or picker.returncode == 1:
        return
    picker.check_returncode()
    action, _, selected = picker.stdout.partition("\n")
    selected = selected.removesuffix("\n")
    if selected:
        if action == "ctrl-y":
            copy_to_clipboard(selected)
        elif action == "ctrl-o":
            open_selection(selected, pane_id, herdr)
        else:
            subprocess.run([herdr, "pane", "send-text", pane_id, selected], check=True, stdout=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
